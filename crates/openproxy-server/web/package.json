{
  "name": "openproxy-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "typecheck:all": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "build": "node build.mjs && tsc --emitDeclarationOnly",
    "build:watch": "node build.mjs --watch",
    "test:e2e": "rm -f tests/e2e/data-test.db* && cp tests/e2e/data-test.seed.db tests/e2e/data-test.db && playwright test",
    "test": "vitest run src/static/src",
    "lint": "oxlint --config oxlint.config.ts"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.78.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "oxlint": "^1.78.0",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "lit-html": "^3.3.3",
    "uplot": "^1.6.31"
  }
}
