From de8d7cd4b110256e805f27189740467fa486847c Mon Sep 17 00:00:00 2001
From: soyelmismo <thinkboutme@protonmail.com>
Date: Sun, 15 Nov 2026 04:01:37 +0000
Subject: [PATCH] ux(a11y): [UX-05] garantizar tamano minimo de objetivos
 tactiles (WCAG 2.5.8 / 2.5.5) y estabilidad visual sin CLS

---
 .../static/styles/components/data-grid.css    | 12 ++++++++
 .../src/static/styles/components/forms.css    | 28 ++++++++++++++-----
 .../web/src/static/styles/layout.css          |  4 +--
 3 files changed, 35 insertions(+), 9 deletions(-)

diff --git a/crates/openproxy-server/web/src/static/styles/components/data-grid.css b/crates/openproxy-server/web/src/static/styles/components/data-grid.css
index a052ea1..008c7f1 100644
--- a/crates/openproxy-server/web/src/static/styles/components/data-grid.css
+++ b/crates/openproxy-server/web/src/static/styles/components/data-grid.css
@@ -361,3 +361,15 @@
   border: 0;
   border-top: var(--border-w) var(--border-style) var(--color-border);
 }
+
+@media (pointer: coarse) {
+  .dg-qa {
+    opacity: 1;
+    min-width: 32px;
+    min-height: 32px;
+  }
+  .ctx-menu button {
+    min-height: 44px;
+    padding: 8px 12px;
+  }
+}
diff --git a/crates/openproxy-server/web/src/static/styles/components/forms.css b/crates/openproxy-server/web/src/static/styles/components/forms.css
index 0ed1d1d..a2a430f 100644
--- a/crates/openproxy-server/web/src/static/styles/components/forms.css
+++ b/crates/openproxy-server/web/src/static/styles/components/forms.css
@@ -32,7 +32,7 @@ button.danger:hover:not(:disabled) {
   background: var(--color-error-soft);
   color: var(--color-error);
 }
-button.small { padding: 0.2rem 0.5rem; font-size: var(--fs-xs); }
+button.small { padding: 0.2rem 0.5rem; font-size: var(--fs-xs); min-height: 24px; }
 .btn {
   display: inline-flex;
   align-items: center;
@@ -89,6 +89,8 @@ button.close-btn {
   font-size: 1.2rem;
   line-height: 1;
   padding: 0 var(--space-2);
+  min-width: 28px;
+  min-height: 28px;
   flex-shrink: 0;
   display: inline-flex;
   align-items: center;
@@ -183,9 +185,9 @@ button.close-btn {
   position: relative;
   display: inline-flex;
   align-items: center;
-  width: 40px;
-  height: 22px;
-  border-radius: 11px;
+  width: 42px;
+  height: 24px;
+  border-radius: 12px;
   border: 1px solid var(--color-border);
   background: var(--color-surface);
   cursor: pointer;
@@ -203,7 +205,7 @@ button.close-btn {
 }
 .toggle-btn .toggle-thumb {
   position: absolute;
-  top: 2px;
+  top: 3px;
   width: 16px;
   height: 16px;
   border-radius: 50%;
@@ -212,16 +214,28 @@ button.close-btn {
   transition: transform 0.2s;
 }
 .toggle-btn.on .toggle-thumb {
-  transform: translateX(19px);
+  transform: translateX(21px);
 }
 .toggle-btn.off .toggle-thumb {
-  transform: translateX(2px);
+  transform: translateX(3px);
 }
 .toggle-btn:focus-visible {
   outline: 2px solid var(--color-primary);
   outline-offset: 2px;
 }
 
+@media (pointer: coarse) {
+  button.close-btn,
+  .theme-toggle {
+    min-width: 44px;
+    min-height: 44px;
+  }
+  button.small,
+  .btn-sm {
+    min-height: 36px;
+  }
+}
+
 /* Shared .actions button-bar. The mobile grid override
    (.actions:has(button)) lives in the view that owns the layout. */
 .actions {
diff --git a/crates/openproxy-server/web/src/static/styles/layout.css b/crates/openproxy-server/web/src/static/styles/layout.css
index f8736ba..b155e04 100644
--- a/crates/openproxy-server/web/src/static/styles/layout.css
+++ b/crates/openproxy-server/web/src/static/styles/layout.css
@@ -542,8 +542,8 @@ body.on-login-page .sidebar { display: none; }
   border-color: var(--color-primary);
   box-shadow: 0 0 0 2px var(--color-primary-soft);
 }
-.login-error-slot { min-height: 0; }
-.login-error { margin: 0; }
+.login-error-slot { min-height: 2.75rem; }
+.login-error { margin: 0; min-height: 2.75rem; display: flex; align-items: center; padding: 0.5rem 0.75rem; }
 .login-submit { align-self: flex-start; }
 
 /* Secondary path for visitors without a key: a quiet hint over a full-width
-- 
2.34.1

