From c1d5e59959e39c63b1fd65360321ad9db8d50530 Mon Sep 17 00:00:00 2001
From: soyelmismo <thinkboutme@protonmail.com>
Date: Sun, 15 Nov 2026 03:54:12 +0000
Subject: [PATCH] ux(a11y): [A11Y-01] corregir ratios de contraste WCAG 2.2 AA
 en tokens de tema y overlay de reconexion

---
 .../styles/components/server-reconnect.css    | 51 ++++++++++---------
 .../web/src/static/styles/themes.css          | 18 +++----
 .../web/src/static/styles/tokens.css          | 20 ++++----
 3 files changed, 45 insertions(+), 44 deletions(-)

diff --git a/crates/openproxy-server/web/src/static/styles/components/server-reconnect.css b/crates/openproxy-server/web/src/static/styles/components/server-reconnect.css
index 2798446..741b241 100644
--- a/crates/openproxy-server/web/src/static/styles/components/server-reconnect.css
+++ b/crates/openproxy-server/web/src/static/styles/components/server-reconnect.css
@@ -24,12 +24,12 @@
 }
 
 .server-reconnect-card {
-  background: var(--bg-surface, #1e1e2e);
-  color: var(--text-main, #cdd6f4);
-  border: 1px solid var(--border-color, #313244);
-  border-radius: var(--radius-lg, 12px);
-  padding: var(--space-6, 24px) var(--space-8, 32px);
-  box-shadow: 0 16px 36px rgba(0, 0, 0, 0.45);
+  background: var(--color-surface);
+  color: var(--color-text);
+  border: var(--border-w) var(--border-style) var(--color-border);
+  border-radius: var(--radius-lg);
+  padding: var(--space-6) var(--space-8);
+  box-shadow: var(--shadow-xl);
   display: flex;
   flex-direction: column;
   align-items: center;
@@ -53,11 +53,11 @@
 .server-reconnect-spinner {
   width: 44px;
   height: 44px;
-  border: 4px solid var(--border-color, #313244);
-  border-top-color: var(--color-primary, #89b4fa);
+  border: 4px solid var(--color-border);
+  border-top-color: var(--color-primary);
   border-radius: 50%;
   animation: reconnectSpin 0.9s linear infinite;
-  margin-bottom: var(--space-4, 16px);
+  margin-bottom: var(--space-4);
 }
 
 @keyframes reconnectSpin {
@@ -67,33 +67,34 @@
 }
 
 .server-reconnect-text h3 {
-  margin: 0 0 var(--space-2, 8px);
-  font-size: var(--fs-lg, 1.25rem);
+  margin: 0 0 var(--space-2);
+  font-size: var(--fs-lg);
   font-weight: 600;
-  color: var(--text-main, #cdd6f4);
+  color: var(--color-text);
 }
 
 .server-reconnect-text p {
-  margin: 0 0 var(--space-5, 20px);
-  font-size: var(--fs-sm, 0.875rem);
-  color: var(--text-muted, #a6adc8);
-  line-height: 1.45;
+  margin: 0 0 var(--space-5);
+  font-size: var(--fs-sm);
+  color: var(--color-text-muted);
+  line-height: var(--lh-base);
 }
 
 .server-reconnect-btn {
-  background: var(--bg-surface-hover, #313244);
-  color: var(--text-main, #cdd6f4);
-  border: 1px solid var(--border-color, #45475a);
-  border-radius: var(--radius-md, 8px);
+  background: var(--color-surface-2);
+  color: var(--color-text);
+  border: var(--border-w) var(--border-style) var(--color-border);
+  border-radius: var(--radius-md);
   padding: 8px 18px;
-  font-size: var(--fs-sm, 0.875rem);
+  min-height: 36px;
+  font-size: var(--fs-sm);
   font-weight: 500;
   cursor: pointer;
-  transition: all 0.15s ease;
+  transition: background var(--t-fast), color var(--t-fast), border-color var(--t-fast);
 }
 
 .server-reconnect-btn:hover {
-  background: var(--color-primary, #89b4fa);
-  color: #11111b;
-  border-color: var(--color-primary, #89b4fa);
+  background: var(--color-primary);
+  color: var(--color-primary-fg);
+  border-color: var(--color-primary);
 }
diff --git a/crates/openproxy-server/web/src/static/styles/themes.css b/crates/openproxy-server/web/src/static/styles/themes.css
index 425e157..be77e0f 100644
--- a/crates/openproxy-server/web/src/static/styles/themes.css
+++ b/crates/openproxy-server/web/src/static/styles/themes.css
@@ -7,7 +7,7 @@
   --color-surface-soft:  var(--color-surface-2);
   --color-text:         #17212b;
   --color-text-emphasis:#0d151c;
-  --color-text-muted:   #667085;
+  --color-text-muted:   #596375;
   --color-text-inverse: var(--c-canvas);
   --color-link:         var(--c-link);
   --color-link-hover:   #1d4ed8;
@@ -16,15 +16,15 @@
   --color-frame-ink:    #c7d0dc;
 
   --color-primary:        var(--c-dell-red);
-  --color-primary-hover:  #c91825;
+  --color-primary-hover:  #a8121b;
   --color-primary-fg:     var(--c-canvas);
-  --color-primary-soft:   #f6dada;
+  --color-primary-soft:   #f8e2e2;
 
-  --color-success:        #4d7c2a;
-  --color-success-soft:   #d8e2c8;
-  --color-warn:           #a86a00;
+  --color-success:        #356318;
+  --color-success-soft:   #e2ecd5;
+  --color-warn:           #855200;
   --color-warning:        var(--color-warn);
-  --color-warn-soft:      #f5d9b8;
+  --color-warn-soft:      #faebd7;
   --color-error:          #b21f1f;
   --color-error-soft:     #f3cdcd;
   --color-info:           #2b5a78;
@@ -92,7 +92,7 @@
   --color-status-err-soft:  var(--color-error-soft);
   --color-status-warn:      var(--color-warn);
   --color-status-warn-soft: var(--color-warn-soft);
-  --color-status-lost:      #78746e;
+  --color-status-lost:      #9e9990;
   --color-status-lost-soft: #262523;
 
   --color-status-ok-bright:    #4ade80;
@@ -177,7 +177,7 @@
     --color-status-err-soft:  var(--color-error-soft);
     --color-status-warn:      var(--color-warn);
     --color-status-warn-soft: var(--color-warn-soft);
-    --color-status-lost:      #78746e;
+    --color-status-lost:      #9e9990;
     --color-status-lost-soft: #262523;
 
     --color-status-ok-bright:    #4ade80;
diff --git a/crates/openproxy-server/web/src/static/styles/tokens.css b/crates/openproxy-server/web/src/static/styles/tokens.css
index 0412fb9..3705c5b 100644
--- a/crates/openproxy-server/web/src/static/styles/tokens.css
+++ b/crates/openproxy-server/web/src/static/styles/tokens.css
@@ -19,7 +19,7 @@
 
 :root {
   /* Dell brand palette */
-  --c-dell-red:      #e91d2a;
+  --c-dell-red:      #c71620;
   --c-yellow-sticker:#fcc20f;
   --c-purple-stripe: #6a26a4;
 
@@ -47,7 +47,7 @@
   --color-surface-soft:  var(--color-surface-2);
   --color-text:         #17212b;
   --color-text-emphasis:#0d151c;
-  --color-text-muted:   #667085;
+  --color-text-muted:   #596375;
   --color-text-inverse: var(--c-canvas);
   --color-link:         var(--c-link);
   --color-link-hover:   #1d4ed8;
@@ -56,16 +56,16 @@
   --color-frame-ink:    #c7d0dc;
 
   --color-primary:      var(--c-dell-red);
-  --color-primary-hover:#c91825;
+  --color-primary-hover:#a8121b;
   --color-primary-fg:   var(--c-canvas);
 
-  --color-primary-soft: #f6dada;   /* hover/active bg */
+  --color-primary-soft: #f8e2e2;   /* hover/active bg */
 
-  --color-success:      #4d7c2a;   /* sage darkened for AA */
-  --color-success-soft: #d8e2c8;
-  --color-warn:         #a86a00;   /* peach dark */
+  --color-success:      #356318;   /* sage darkened for AA >= 4.5:1 on soft bg */
+  --color-success-soft: #e2ecd5;
+  --color-warn:         #855200;   /* peach darkened for AA >= 4.5:1 on soft bg */
   --color-warning:      var(--color-warn);
-  --color-warn-soft:    #f5d9b8;
+  --color-warn-soft:    #faebd7;
   --color-error:        #b21f1f;   /* salmon dark */
   --color-error-soft:   #f3cdcd;
   --color-info:         #2b5a78;   /* sky dark */
@@ -74,8 +74,8 @@
   /* On-chain payment accent: the indigo of "buy" affordances that lead to
      checkout. The QR itself is painted in the brand red (--c-dell-red) by
      credits_qr::render. */
-  --color-chain:        #6366f1;
-  --color-chain-hover:  #4f46e5;
+  --color-chain:        #4f46e5;
+  --color-chain-hover:  #4338ca;
   --color-chain-fg:     #ffffff;
 
   /* Status pills (log row) */
-- 
2.34.1

